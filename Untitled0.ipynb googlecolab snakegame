        "game_html += \"\"\"\n",
        "function drawGame() {\n",
        "\n",
        "    // Clear the screen\n",
        "    ctx.fillStyle = \"#b8cf8b\";\n",
        "    ctx.fillRect(0, 0, 400, 400);\n",
